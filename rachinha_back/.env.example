# .env.example
# Exemplo de variáveis de ambiente para executar o backend localmente
# Copie este arquivo para `.env` e preencha os valores reais. NÃO comite o
# arquivo `.env` contendo segredos em repositórios públicos.

# --- Banco de dados
# URL de conexão com o MongoDB. Em Docker Compose o host (service) é `mongo`.
MONGODB_URL="mongodb://mongo:27017"
# Nome do banco de dados
DB_NAME="rachinha"

# --- App / Segurança
# Chave secreta usada para assinar tokens JWT (mude para uma string segura)
JWT_SECRET="alguma_chave_secreta"
# Caminho base (root path) exposto pela API
ROOT_PATH="/rachinha"
# Tempo de expiração do access token (minutos)
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- API de e-mail (BMail) - opcional
BMAIL_API_URL=""
BMAIL_CLIENT_ID=""
BMAIL_CLIENT_SECRET=""

# --- Google OAuth
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Callback do Google (ajuste se alterar ROOT_PATH ou porta)
GOOGLE_REDIRECT_URI="http://localhost:8001/auth/google/callback"
GOOGLE_ANDROID_CLIENT_ID=""
GOOGLE_IOS_CLIENT_ID=""

# --- Apple Sign In (opcional)
APPLE_SERVICE_ID=""
APPLE_BUNDLE_ID=""

# --- Serviço interno (opcional)
SERVICE_CLIENT_ID=""
SERVICE_CLIENT_SECRET=""

# URL do serviço de storage (opcional)
STORAGE_API_URL=""

# Origem(s) permitida(s) para CORS (separe por vírgula)
# Ex.: ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
ALLOWED_ORIGINS="http://localhost:3000"

# --- SMTP / envio de e-mail (se usado pelo projeto)
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""

# --- Outros (adicione conforme necessário)
# DEBUG=true
